# 默认使用免密钥 Open-Meteo，项目复制后即可运行。
# auto：配置和风后优先使用和风，失败自动降级；open-meteo：强制免密钥来源；qweather：优先和风。
WEATHER_PROVIDER=auto

# 和风天气控制台分配的 API Host，例如 abcxyz.qweatherapi.com（不要填公共固定域名）。
QWEATHER_API_HOST=

# 任选一种凭据。JWT 更安全且为官方推荐；同时填写时程序只发送 JWT，避免双重认证失败。
QWEATHER_JWT=
QWEATHER_API_KEY=

# 留空时：检测到 AMAP_API_KEY 自动使用高德，否则使用景区维护库 + Open-Meteo 地名服务。
PLACE_PROVIDER=

# 生产环境如需高德 POI 搜索，填写“Web 服务”Key。不要使用 NEXT_PUBLIC_ 前缀。
AMAP_API_KEY=

# 本地默认写入 .data/scenic-weather.sqlite；生产多实例建议配置 PostgreSQL。
SQLITE_PATH=.data/scenic-weather.sqlite
DATABASE_URL=
